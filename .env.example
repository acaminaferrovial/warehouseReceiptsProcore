# Entorno de Procore: 'sandbox' o 'production'
PROCORE_ENVIRONMENT=sandbox

# ID de la Compañía (Tenant en Procore)
PROCORE_COMPANY_ID=104928

# ID y Nombre del Proyecto asignado a esta instancia
PROCORE_PROJECT_ID=29814
PROCORE_PROJECT_NAME=Torre Skyline - Fase 2

# Secret de Autenticación: Bearer Token / Personal Access Token de Procore
# (Se gestiona de forma segura en el backend y NUNCA se expone en el cliente)
